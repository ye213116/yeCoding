+@pytest.mark.parametrize("role", ["coordinator", "verifier"])
+def test_readonly_role_returns_conclusion_within_existing_call_budget(project, role):
+    class ReadingClient(ScriptedClient):
+        def __init__(self):
+            super().__init__()
+            self.rounds = 0
+            self.tool_availability = []
+
+        async def chat(self, messages, tools=None, **kwargs):
+            self.rounds += 1
+            self.tool_availability.append(bool(tools))
+            if tools:
+                yield {
+                    "type": "tool_call_delta",
+                    "tool_call": {
+                        "index": 0,
+                        "id": f"read-{self.rounds}",
+                        "function": {
+                            "name": "read_file",
+                            "arguments": json.dumps({"path": "calc.py"}),
+                        },
+                    },
+                }
+                yield {"type": "message_end", "stop_reason": "tool_use"}
+            else:
+                yield {
+                    "type": "text_delta",
+                    "text": "Concrete conclusion based on inspected source.",
+                }
+                yield {"type": "message_end", "stop_reason": "end_turn"}
+            yield {"type": "usage", "usage": {"input_tokens": 5, "output_tokens": 5}}
+
+    root, config = project
+    client = ReadingClient()
+    repair = workflow(project, client)
+    repair.artifacts.mkdir(parents=True)
+    text = asyncio.run(
+        repair._agent(role, "Inspect the addition implementation", root, readonly=True)
+    )
+    assert text.strip(), "read-only role consumed its tool turns without producing a conclusion"
+    assert client.rounds <= 3
+    assert client.tool_availability == [True, True, False]
+
+
+@pytest.mark.parametrize("role", ["coordinator", "verifier"])
+def test_readonly_role_rejects_tools_in_reserved_final_response(project, role):
+    class PersistentClient(ScriptedClient):
+        async def chat(self, messages, tools=None, **kwargs):
+            yield {
+                "type": "tool_call_delta",
+                "tool_call": {
+                    "index": 0,
+                    "id": "unwanted-read",
+                    "function": {"name": "read_file", "arguments": json.dumps({"path": "calc.py"})},
+                },
+            }
+            yield {"type": "message_end", "stop_reason": "tool_use"}
+            yield {"type": "usage", "usage": {"input_tokens": 5, "output_tokens": 5}}
+
+    root, config = project
+    repair = workflow(project, PersistentClient())
+    repair.artifacts.mkdir(parents=True)
+    with pytest.raises(RuntimeError, match="reserved final response"):
+        asyncio.run(repair._agent(role, "Inspect addition", root, readonly=True))
+    events = [
+        json.loads(line) for line in (repair.artifacts / "events.jsonl").read_text().splitlines()
+    ]
+    assert sum(e["type"] == "tool_call" for e in events) == 2
+    assert repair.client.calls == 3
